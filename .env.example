# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env asla commit edilmez.

# --- Veritabanı ---
POSTGRES_USER=ictihat
POSTGRES_PASSWORD=degistir
POSTGRES_DB=ictihat
POSTGRES_PORT=5432
# Backend'in kullandığı bağlantı (docker içinde host "db", yerelde "localhost")
DATABASE_URL=postgresql+psycopg://ictihat:degistir@localhost:5432/ictihat

# --- Uygulama ---
APP_ENV=development
SECRET_KEY=uzun-rastgele-bir-deger-uretin
CORS_ORIGINS=http://localhost:3000

# --- Embedding ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- LLM (Anthropic Claude API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Ödeme (iyzico) ---
# fake: geliştirme için sahte sağlayıcı (gerçek ödeme yok); iyzico: sandbox veya canlı
PAYMENT_PROVIDER=fake
# iyzico ödeme sonucunu buraya döndürür; dışarıdan erişilebilir olmalı
BACKEND_URL=http://localhost:8000
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_MERCHANT_ID=
IYZICO_PLAN_REFERENCE_CODE=
# Webhook imza özelliği iyzico'dan açtırılmalı (entegrasyon@iyzico.com)
IYZICO_WEBHOOK_REQUIRE_SIGNATURE=true
SUBSCRIPTION_PRICE_TEXT=

# --- Ön yüz ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Oturum ve üyelik ---
SESSION_COOKIE_NAME=ictihat_oturum
SESSION_TTL_MINUTES=10080
# Üretimde (HTTPS) true olmalı
COOKIE_SECURE=false
EMAIL_VERIFY_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
FRONTEND_URL=http://localhost:3000
# console: e-postaları günlüğe yazar (yalnızca geliştirme)
EMAIL_BACKEND=console
EMAIL_FROM=İçtihat Arama <no-reply@localhost>
FREE_SEARCHES_PER_MONTH=3
QUOTA_TIMEZONE=Europe/Istanbul
# Arama uç noktası hazır olana kadar ön yüz örnek sonuç gösterir; gerçek uç için false
NEXT_PUBLIC_MOCK_SEARCH=true

# --- Güvenlik ---
RATE_LIMIT_ENABLED=true
# Önde nginx vb. ters vekil varsa sayısı (X-Forwarded-For yalnızca o zaman okunur)
TRUSTED_PROXY_COUNT=0
MAX_REQUEST_BODY_BYTES=65536
# Ön yüz: üretimde HTTPS arkasında HSTS başlığı
ENABLE_HSTS=false
